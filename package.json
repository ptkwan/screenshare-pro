{
  "name": "screenshare-pro",
  "version": "1.18.0",
  "description": "App de compartilhamento de tela em rede local",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run start\"",
    "build:css": "tailwindcss -i ./tailwind-input.css -o ./styles.css --minify",
    "prestart": "npm run build:css",
    "prebuild": "npm run build:css",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.seu-nome.screensharepro",
    "productName": "Streama AI",
    "asarUnpack": [
      "node_modules/loopback-capture/**/*",
      "native/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "ptkwan",
      "repo": "screenshare-pro",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@upstash/redis": "^1.38.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "loopback-capture": "^2.0.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "electron": "^24.0.0",
    "electron-builder": "^24.4.0",
    "tailwindcss": "^3.4.19"
  },
  "allowScripts": {
    "electron@24.8.8": true
  }
}
